{
  "$schema": "../schemas/blueprint.schema.json",
  "description": "Zajętość storage groups: dashboard na LPAR, panel na SGN, seria na MYTYPE. Panel podsumowania: MYTYPE=3 to procent zajętości SG - jeśli w danych jest inny numer, popraw summaryPanel.filter i filters.MYTYPE",
  "measurement": "HF.STG_SPACE",
  "field": "VAL",
  "aggregation": "mean",
  "grouping": {
    "dashboardTag": "LPAR",
    "panelTag": "SGN",
    "seriesTag": "MYTYPE"
  },
  "filters": {
    "MYTYPE": {
      "exclude": [
        "3"
      ]
    }
  },
  "dashboardTitle": "{dashboard} - {measurement}",
  "panelTitle": "{dashboard} / {panel}",
  "seriesAlias": "{panel} {series}",
  "unit": "decgbytes",
  "axisLabel": "Zajętość",
  "tags": [
    "auto-generated",
    "storage"
  ],
  "summaryPanel": {
    "title": "{dashboard} - zajętość SG [%]",
    "filter": {
      "MYTYPE": "3"
    },
    "unit": "percent",
    "axisLabel": "Zajętość",
    "min": 0,
    "max": 100,
    "thresholds": [
      {
        "value": 80,
        "color": "orange"
      },
      {
        "value": 90,
        "color": "red"
      }
    ],
    "height": 9
  },
  "alert": {
    "threshold": 90,
    "evaluator": "gt",
    "reducer": "last",
    "pendingPeriod": "5m",
    "lookbackSeconds": 3600,
    "interval": "5m",
    "ruleGroup": "storage-space",
    "severity": "warning"
  }
}
