# --- Aplikacja ---
PORT=3001
APP_API_KEY=change-me            # wymagany przez serwer HTTP (nie przez CLI)
LOG_PATH=logs/app.log            # log wszystkich operacji (JSON Lines); wspólny dla serwera i CLI
LOG_LEVEL=info                   # debug | info | warn | error; debug = każde zapytanie do Grafany/InfluxDB, treść webhooków
LOG_CONSOLE_LEVEL=               # poziom na konsoli (domyślnie: serwer info, CLI warn)
LOG_FORMAT=json                  # json (JSON Lines, do jq/grep) | text
LOG_MAX_SIZE_MB=20               # rotacja: app.log -> app.log.1 ... po przekroczeniu rozmiaru
LOG_MAX_FILES=10
NODE_ENV=development

# --- Webhook alertów (contact point Grafany) ---
WEBHOOK_AUTH_TOKEN=              # zalecane: Grafana wysyła "Authorization: Bearer <token>" (contact point: Authorization header)
WEBHOOK_BASIC_USER=              # albo HTTP Basic (contact point: Username / Password) - oba pola razem
WEBHOOK_BASIC_PASSWORD=
WEBHOOK_QUEUE_PATH=data/webhook-queue.db   # trwała kolejka powiadomień (SQLite); restart nie gubi powiadomień
WEBHOOK_DEDUPE_MINUTES=10        # identyczne powiadomienie w tym oknie jest pomijane (0 - wyłączone)
WEBHOOK_RETRY_DELAYS=1m,5m,15m,1h,3h   # odstępy ponowień po błędzie (np. niedostępny SMTP); potem status "failed"
WEBHOOK_QUEUE_POLL_SECONDS=15    # jak często serwer sprawdza kolejkę (ponowienia, "queue retry" z CLI)
WEBHOOK_QUEUE_RETENTION_DAYS=30  # zakończone zadania starsze niż tyle dni są usuwane

# --- Grafana ---
GRAFANA_URL=http://localhost:3000
GRAFANA_API_READ_TOKEN=
GRAFANA_API_WRITE_TOKEN=         # wymagany przez serwer; CLI używa tokenu odczytu, jeśli brak
GRAFANA_API_VERSION=v1beta1
GRAFANA_NAMESPACE=default
GRAFANA_FOLDER_UID=              # domyślny folder dashboardów i reguł alertów
GRAFANA_DEFAULT_RULE_GROUP=automation

# --- InfluxDB (1.x, InfluxQL) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_DATABASE=metrics
INFLUXDB_USERNAME=root
INFLUXDB_PASSWORD=root
INFLUXDB_DATASOURCE_UID=         # UID źródła InfluxDB w Grafanie (panele i alerty)

# --- Wykresy ---
SELECTED_PLOTTER=gnuplot         # gnuplot (SVG) | chartjs (canvas, PNG)
PLOT_OUTPUT_PATH=plots
PLOT_TIME_RANGE_HOURS=360        # zakres wykresu w mailu z alertem

# --- E-mail ---
EMAIL_ALERT_SENDER=alert@local.internal
EMAIL_ALERT_RECIPIENT=admin@local.internal
EMAIL_ROUTING_PATH=config/email-routing.json
ALERT_TEMPLATE_PATH=templates/email/alert.html
MAIL_TRANSPORT=sendmail         # sendmail | smtp
SENDMAIL_PATH=/usr/sbin/sendmail
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false               # true dla SMTPS (port 465)
SMTP_USER=
SMTP_PASSWORD=

# --- Provisioning ---
SERIES_INACTIVE_AFTER_HOURS=168  # seria bez danych dłużej niż 7 dni jest nieaktywna:
                                 # nie powstaje dla niej panel, a reguły istniejących paneli są pauzowane

# --- Pliki konfiguracyjne ---
BLUEPRINTS_PATH=blueprints
REPORTS_PATH=reports
REPORTS_OUTPUT_PATH=reports-output
