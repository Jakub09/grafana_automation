{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "measurement": {
      "type": "string",
      "minLength": 1,
      "description": "Pomiar InfluxDB"
    },
    "database": {
      "type": "string",
      "description": "Baza InfluxDB (domyślnie INFLUXDB_DATABASE)"
    },
    "datasourceUid": {
      "type": "string",
      "description": "Źródło danych Grafany dla paneli i alertów (domyślnie INFLUXDB_DATASOURCE_UID)"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "description": "Pole z wartością"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Kilka pól - bez grouping.seriesTag każde pole to osobna seria na panelu"
    },
    "aggregation": {
      "type": "string",
      "enum": [
        "mean",
        "max",
        "min",
        "last",
        "sum"
      ],
      "default": "mean"
    },
    "grouping": {
      "type": "object",
      "properties": {
        "dashboardTag": {
          "type": "string",
          "minLength": 1,
          "description": "Tag wyznaczający dashboard; bez niego - jeden wspólny dashboard"
        },
        "panelTag": {
          "type": "string",
          "minLength": 1,
          "description": "Tag wyznaczający panel"
        },
        "seriesTag": {
          "type": "string",
          "minLength": 1,
          "description": "Tag wyznaczający serię na panelu"
        }
      },
      "required": [
        "panelTag"
      ],
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tylko te wartości (wzorce z *, np. \"LPAR*\")"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Pomiń te wartości (wzorce z *, np. \"TEST*\")"
          }
        },
        "additionalProperties": false
      },
      "default": {},
      "description": "Filtry wartości tagów, np. { \"SYSTEM\": { \"exclude\": [\"TEST*\"] } }"
    },
    "queries": {
      "type": "object",
      "properties": {
        "panel": {
          "type": "string",
          "description": "Własny szablon zapytania serii panelu"
        },
        "alert": {
          "type": "string",
          "description": "Własny szablon zapytania alertu"
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "Znaczniki: {measurement} {field} {aggregation} {dashboard} {panel} {series} {where} {interval}. Zapytanie panelu musi zawierać $timeFilter i GROUP BY time($__interval)."
    },
    "minInterval": {
      "type": "string",
      "pattern": "^\\d+(s|m|h|d|w)$",
      "description": "Grafana \"Min interval\" paneli i podsumowania: najmniejszy $__interval, np. \"1d\" przy danych dziennych - zapytania zwracają punkt na dzień zamiast setek pustych kubełków. Istniejące panele - provision apply --update."
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "refresh": {
          "type": "string",
          "pattern": "^(\\d+[smhd])?$",
          "description": "Automatyczne odświeżanie dashboardu (\"\" - wyłączone; domyślnie 5m). Przy danych dziennych: \"\" albo \"1h\""
        },
        "timeFrom": {
          "type": "string",
          "description": "Domyślny zakres czasu, np. \"now-30d\" (domyślnie now-7d)"
        }
      },
      "additionalProperties": false,
      "description": "Ustawienia dashboardów; istniejące - provision apply --update"
    },
    "connectNulls": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^\\d+[smhd]$"
        }
      ],
      "description": "Grafana \"Connect null values\" w panelach i podsumowaniu: true - Always, false - Never, \"1h\" - Threshold (łączy przerwy krótsze niż podany czas). Bez tego klucza - ustawienie z Grafany bez zmian."
    },
    "layout": {
      "type": "object",
      "properties": {
        "panelsPerRow": {
          "type": "number",
          "enum": [
            1,
            2,
            3,
            4,
            6,
            8,
            12
          ],
          "default": 2,
          "description": "Paneli w wierszu (dzielnik 24: 1, 2, 3, 4, 6, 8, 12)"
        },
        "panelHeight": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30,
          "default": 8,
          "description": "Wysokość panelu w siatce Grafany (1 = ok. 30 px)"
        }
      },
      "additionalProperties": false,
      "description": "Układ paneli na dashboardzie; panel podsumowania jest zawsze na całą szerokość na górze. Z \"provision apply --update\" także istniejące dashboardy są przestawiane."
    },
    "panelQueries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "refId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Identyfikator zapytania - wyrażenia odwołują się do niego ($A, $B)"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "Nazwa serii w legendzie; wzorce {dashboard} {panel}"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Zapytanie InfluxQL; znaczniki jak w \"queries\" ({where} = dashboard + panel + filtry), makra $timeFilter i $__interval"
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "description": "Wyrażenie Grafany (Server Side Expression \"Math\"), np. \"$A / $B\", \"($A - $B) / 1024\", \"$A / $B * 100\""
          },
          "threshold": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "description": "Zapytanie wejściowe, np. \"B\""
              },
              "evaluator": {
                "type": "string",
                "enum": [
                  "gt",
                  "lt",
                  "within_range",
                  "outside_range"
                ],
                "default": "gt",
                "description": "gt - is above, lt - is below, within_range - is within range, outside_range - is outside range"
              },
              "value": {
                "type": "number",
                "description": "Próg dla gt / lt, np. 90"
              },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "description": "Zakres [od, do] dla within_range / outside_range"
              }
            },
            "required": [
              "input"
            ],
            "additionalProperties": false,
            "description": "Wyrażenie Grafany \"Threshold\": 1 gdy warunek spełniony, 0 gdy nie (dla każdego punktu), np. { \"input\": \"B\", \"evaluator\": \"gt\", \"value\": 90 }"
          },
          "color": {
            "type": "string",
            "description": "Kolor: nazwa z Grafany (red, orange...) lub #RRGGBB"
          },
          "dashed": {
            "type": "boolean",
            "default": false,
            "description": "Linia przerywana bez wypełnienia"
          },
          "unit": {
            "type": "string",
            "description": "Jednostka tej serii, gdy inna niż panelu (np. \"percentunit\" dla $A / $B) - rysowana na prawej osi"
          },
          "hidden": {
            "type": "boolean",
            "description": "Zapytanie liczone, ale nierysowane (np. składnik wyrażenia)"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Własna lista zapytań każdego panelu ZAMIAST serii generowanych z grouping.seriesTag / pól. Zapytania InfluxDB (\"query\") i wyrażenia Grafany (\"expression\": \"$A / $B\"); znaczniki jak w \"queries\"."
    },
    "extraQueries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "refId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Identyfikator zapytania - wyrażenia odwołują się do niego ($A, $B)"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "Nazwa serii w legendzie; wzorce {dashboard} {panel}"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Zapytanie InfluxQL; znaczniki jak w \"queries\" ({where} = dashboard + panel + filtry), makra $timeFilter i $__interval"
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "description": "Wyrażenie Grafany (Server Side Expression \"Math\"), np. \"$A / $B\", \"($A - $B) / 1024\", \"$A / $B * 100\""
          },
          "threshold": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "description": "Zapytanie wejściowe, np. \"B\""
              },
              "evaluator": {
                "type": "string",
                "enum": [
                  "gt",
                  "lt",
                  "within_range",
                  "outside_range"
                ],
                "default": "gt",
                "description": "gt - is above, lt - is below, within_range - is within range, outside_range - is outside range"
              },
              "value": {
                "type": "number",
                "description": "Próg dla gt / lt, np. 90"
              },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "description": "Zakres [od, do] dla within_range / outside_range"
              }
            },
            "required": [
              "input"
            ],
            "additionalProperties": false,
            "description": "Wyrażenie Grafany \"Threshold\": 1 gdy warunek spełniony, 0 gdy nie (dla każdego punktu), np. { \"input\": \"B\", \"evaluator\": \"gt\", \"value\": 90 }"
          },
          "color": {
            "type": "string",
            "description": "Kolor: nazwa z Grafany (red, orange...) lub #RRGGBB"
          },
          "dashed": {
            "type": "boolean",
            "default": true,
            "description": "Linia przerywana bez wypełnienia"
          },
          "unit": {
            "type": "string",
            "description": "Jednostka tej serii, gdy inna niż panelu (np. \"percentunit\" dla $A / $B) - rysowana na prawej osi"
          },
          "hidden": {
            "type": "boolean",
            "description": "Zapytanie liczone, ale nierysowane (np. składnik wyrażenia)"
          }
        },
        "additionalProperties": false
      },
      "description": "Dodatkowe zapytania w każdym panelu, po seriach - np. próg liczony z pojemności (90% TOTAL.GB) albo wyrażenie z serii panelu (\"expression\": \"$B / $A\")"
    },
    "folderUid": {
      "type": "string",
      "description": "Folder Grafany (domyślnie GRAFANA_FOLDER_UID)"
    },
    "dashboardTitle": {
      "type": "string",
      "default": "{dashboard} - {measurement}",
      "description": "Wzorce: {measurement} {dashboard}"
    },
    "panelTitle": {
      "type": "string",
      "default": "{dashboard} / {panel}",
      "description": "Wzorce: {measurement} {dashboard} {panel}"
    },
    "seriesAlias": {
      "type": "string",
      "default": "{panel} {series}",
      "description": "Wzorce: {measurement} {dashboard} {panel} {series}"
    },
    "unit": {
      "type": "string",
      "description": "Jednostka Grafany, np. \"decgbytes\", \"percent\""
    },
    "axisLabel": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "auto-generated"
      ]
    },
    "inactiveAfterHours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Seria bez danych dłużej niż tyle godzin jest nieaktywna (domyślnie SERIES_INACTIVE_AFTER_HOURS)"
    },
    "summaryPanel": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "default": "{dashboard} - zajętość [%]",
          "description": "Tytuł; wzorce: {measurement} {dashboard}"
        },
        "filter": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Warunki tagów wybierające serie podsumowania, np. { \"MYTYPE\": \"3\" } - seria z procentem zajętości"
        },
        "field": {
          "type": "string",
          "description": "Pole (domyślnie pierwsze pole blueprintu)"
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "mean",
            "max",
            "min",
            "last",
            "sum"
          ]
        },
        "query": {
          "type": "string",
          "description": "Własne zapytanie zamiast generowanego; {where} = dashboard + filter, wynik musi mieć GROUP BY tag panelu"
        },
        "alias": {
          "type": "string",
          "description": "Nazwa serii w legendzie (domyślnie $tag_<panelTag>, np. nazwa SG)"
        },
        "unit": {
          "type": "string",
          "default": "percent"
        },
        "axisLabel": {
          "type": "string"
        },
        "min": {
          "type": "number",
          "default": 0
        },
        "max": {
          "type": "number",
          "default": 100
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "color": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "color"
            ],
            "additionalProperties": false
          },
          "default": [
            {
              "value": 80,
              "color": "orange"
            },
            {
              "value": 90,
              "color": "red"
            }
          ],
          "description": "Linie progów na wykresie"
        },
        "height": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30,
          "default": 9,
          "description": "Wysokość panelu w siatce Grafany"
        }
      },
      "additionalProperties": false,
      "description": "Panel na samej górze każdego dashboardu z seriami wszystkich paneli (np. procent zajętości wszystkich SG)"
    },
    "alert": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number"
        },
        "evaluator": {
          "type": "string",
          "enum": [
            "gt",
            "lt"
          ],
          "default": "gt",
          "description": "gt: alert powyżej progu, lt: poniżej"
        },
        "reducer": {
          "type": "string",
          "enum": [
            "last",
            "mean",
            "max",
            "min",
            "sum",
            "count"
          ],
          "default": "last"
        },
        "field": {
          "type": "string",
          "description": "Pole alertu (domyślnie pierwsze pole)"
        },
        "showOnChart": {
          "type": "boolean",
          "description": "Linia progu i moment przekroczenia na wykresie w mailu; domyślnie tak, chyba że jest queries.alert (np. procent przy panelu w GB)"
        },
        "pendingPeriod": {
          "type": "string",
          "pattern": "^(\\d+(ms|s|m|h|d|w))+$",
          "default": "5m",
          "description": "Jak długo warunek musi trwać, zanim alert się odpali"
        },
        "lookbackSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3600
        },
        "interval": {
          "type": "string",
          "pattern": "^(\\d+(ms|s|m|h|d|w))+$",
          "default": "5m"
        },
        "ruleGroup": {
          "type": "string",
          "minLength": 1,
          "description": "Grupa reguł w Grafanie; \"{dashboard}\" daje grupę na dashboard (np. \"mf-storage-{dashboard}\") - Grafana rozkłada ewaluację grup w czasie, więc przy setkach reguł to odciąża bazę"
        },
        "severity": {
          "type": "string",
          "default": "warning"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "receiver": {
          "type": "string",
          "description": "Contact point Grafany, do którego reguły wysyłają powiadomienia (z pominięciem polityki powiadomień); bez niego - wg polityki powiadomień"
        },
        "notification": {
          "type": "object",
          "properties": {
            "groupBy": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Grupowanie alertów w jedno powiadomienie, np. [\"alertname\", \"grafana_folder\"]"
            },
            "groupWait": {
              "type": "string",
              "pattern": "^(\\d+(ms|s|m|h|d|w))+$",
              "description": "Czekanie na kolejne alerty grupy przed pierwszym powiadomieniem, np. \"30s\""
            },
            "groupInterval": {
              "type": "string",
              "pattern": "^(\\d+(ms|s|m|h|d|w))+$",
              "description": "Odstęp powiadomień o zmianach w grupie, np. \"5m\""
            },
            "repeatInterval": {
              "type": "string",
              "pattern": "^(\\d+(ms|s|m|h|d|w))+$",
              "description": "Przypomnienie o wciąż aktywnym alercie, np. \"4h\""
            },
            "muteTimeIntervals": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Okna wyciszenia (mute timings) z Grafany"
            }
          },
          "additionalProperties": false,
          "description": "Ustawienia powiadomień dla \"receiver\" (wymaga receiver)"
        },
        "evaluationInterval": {
          "type": "string",
          "pattern": "^\\d+[smh]$",
          "description": "Jak często Grafana sprawdza reguły - interwał grupy reguł (folder + ruleGroup), wielokrotność 10 s. pendingPeriod musi być jego wielokrotnością. Bez tego - domyślny interwał Grafany (1m przy nowej grupie)."
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "refId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Zapytanie InfluxQL; znaczniki jak w \"queries.alert\" ({where}, {interval})"
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "description": "Wyrażenie Grafany, np. \"$A / $B\""
              }
            },
            "required": [
              "refId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Własne węzły reguły zamiast jednego zapytania: np. A (USED.GB), B (TOTAL.GB), C = \"$A / $B\". Warunek (reducer + próg) liczony jest z węzła conditionRefId (domyślnie ostatniego)."
        },
        "conditionRefId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Węzeł, z którego liczony jest warunek (domyślnie ostatni z \"queries\")"
        },
        "scope": {
          "type": "string",
          "enum": [
            "panel",
            "dashboard"
          ],
          "default": "panel",
          "description": "panel - reguła na każdy panel; dashboard - jedna reguła wielowymiarowa na dashboard: zapytanie z GROUP BY tagu panelu (np. \"SGN\") daje instancję alertu na każdy panel - wielokrotnie mniej reguł i zapytań. W zapytaniach {where} nie zawiera wtedy warunku panelu, a {panel} jest pusty."
        }
      },
      "required": [
        "threshold",
        "ruleGroup"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "measurement",
    "grouping"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blueprint schematu danych (blueprints/<nazwa>.json)"
}
