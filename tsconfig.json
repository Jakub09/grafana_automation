{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["server.ts", "cli.ts", "src/**/*.ts", "test/**/*.ts", "tools/**/*.ts", "dev/**/*.ts"]
}
