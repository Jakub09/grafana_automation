# crontab użytkownika grafana-automation (crontab -e). TZ wpływa na godziny na wykresach.
TZ=Europe/Warsaw
APP=/opt/grafana-automation

# Synchronizacja wszystkich schematów (blueprints/*.json): nowe panele, pauza/wznowienie reguł nieaktywnych serii
30 2 * * *  cd $APP && /usr/bin/node --env-file=.env dist/cli.js provision apply --all >> logs/cron.log 2>&1

# Raport tygodniowy - poniedziałek 7:00 (pliki i e-mail wg reports/weekly-storage/report.json)
0 7 * * 1   cd $APP && /usr/bin/node --env-file=.env dist/cli.js report run weekly-storage >> logs/cron.log 2>&1

# Raport miesięczny - 1. dnia miesiąca 6:00 (zakres "now-1M/M" w definicji = poprzedni miesiąc)
0 6 1 * *   cd $APP && /usr/bin/node --env-file=.env dist/cli.js report run monthly-storage >> logs/cron.log 2>&1

# Raport alarmowy (email.onlyIfAttention: true) - codziennie 8:00, e-mail tylko gdy coś "wymaga uwagi"
# 0 8 * * *   cd $APP && /usr/bin/node --env-file=.env dist/cli.js report run storage-alarm >> logs/cron.log 2>&1

# Sprzątanie wygenerowanych wykresów i archiwów raportów
15 3 * * *  find $APP/plots -type f -mtime +7 -delete; find $APP/reports-output -type f -mtime +365 -delete
